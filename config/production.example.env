# Copy into your deployment secret manager; do not commit real values.
APP_ENV=production
READ_ONLY_MODE=true
EXECUTION_ENABLED=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/itp
REDIS_URL=redis://HOST:6379/0
APP_BASE_URL=https://YOUR_DOMAIN
SESSION_SECRET=SET_IN_SECRET_MANAGER
MARKET_DATA_TIMEOUT_SECONDS=10
ALERT_POLL_SECONDS=30
LOG_LEVEL=INFO

# Optional public-data providers. Use provider-specific credentials only when required.
COINGECKO_API_KEY=
DEXSCREENER_API_KEY=

# Authentication/billing are intentionally placeholders until providers are selected.
AUTH_ISSUER=
AUTH_AUDIENCE=
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=
