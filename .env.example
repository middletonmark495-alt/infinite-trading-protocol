# ════════════════════════════════════════════════════════════════════════════
#  ITP — Environment Configuration
#  Copy this file to .env and fill in the blank values.
#  NEVER commit your real .env to git.
#
#  Generate a fresh deployer wallet (run locally, save the output securely):
#    cast wallet new
#  Fund the deployer address with ETH on Base + Optimism for gas (~0.01 ETH each).
# ════════════════════════════════════════════════════════════════════════════

# ── Deployer ──────────────────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=        # output of: cast wallet new  (no 0x prefix)

# ── ITP DAO (owner + fee recipient) ───────────────────────────────────────────
ITP_DAO=0xfbC61F8A651622B82829046afb3f10AF666c19e1

# ── Keeper (authorised to call compound() / autoCompound()) ───────────────────
KEEPER_ADDRESS=0xfbC61F8A651622B82829046afb3f10AF666c19e1

# ── RPC endpoints ─────────────────────────────────────────────────────────────
BASE_RPC_URL=                # e.g. https://base-mainnet.g.alchemy.com/v2/<key>
RPC_URL=                     # Optimism, e.g. https://opt-mainnet.g.alchemy.com/v2/<key>

# ── Block explorer API keys ───────────────────────────────────────────────────
BASE_ETHERSCAN_API_KEY=      # basescan.org/myapikey
API_KEY_OPTIMISTIC_ETHERSCAN=# optimistic.etherscan.io/myapikey
ETHERSCAN_API_KEY=           # etherscan.io/myapikey
POLYGONSCAN_API_KEY=         # polygonscan.com (optional, gas monitoring)
OPTIMISM_ETHERSCAN_API_KEY=  # same value as API_KEY_OPTIMISTIC_ETHERSCAN
ARBISCAN_API_KEY=            # arbiscan.io (optional, gas monitoring)
BASESCAN_API_KEY=            # same value as BASE_ETHERSCAN_API_KEY

# ── UniV3AutoCompounder — WETH/USDC 0.05% on Base ────────────────────────────
TOKEN0=0x4200000000000000000000000000000000000006   # WETH on Base
TOKEN1=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913   # USDC on Base
POOL_FEE=500
POOL=0xd0b53D9277642d899DF5C87A3966A349A798F224      # Uniswap V3 WETH/USDC 0.05% pool

# ── InfiniteBoost — Optimism ──────────────────────────────────────────────────
ITP_TOKEN_ADDRESS=0x0a7B751FcDBBAA8BB988B9217ad5Fb5cfe7bf7A0    # ITP  (boost reward token)
VELO_TOKEN_ADDRESS=0x9560e827aF36c94D2Ac33a39bCE1Fe78631088Db   # VELO (base reward / DAO token)
WETH_TOKEN_ADDRESS=0x4200000000000000000000000000000000000006    # WETH on Optimism
USDT_TOKEN_ADDRESS=0x0b2C639c533813f4Aa9D7837CAf62653d097Ff85   # USDC on Optimism (connector)
ROUTER_ADDRESS=0xa062aE8A9c5e11aaA026fc2670B0D65cCc8B2858        # Velodrome V2 router
ORACULE_ADDRESS=0x59BCE8a6c8D9Bc7Db3e4B3aB97A0a1cB3aa9E47b      # 1inch Spot Price Aggregator v5

# ── InfiniteBoost — LP / Gauge (used by fork tests + addGauge() post-deploy) ──
LP_TOKEN_ADDRESS=0xB84C932059A49e82C2c1bb96E29D59Ec921998Be      # ITP-USDC LP on Optimism
GAUGE_ADDRESS=0x571E95563A6798C76144c8C5ed293406Ed81A437          # Velodrome gauge for ITP-USDC

# ── Coinbase Advanced Trade API (optional, for authenticated endpoints) ───────
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ── Notification sinks (optional, for GasMonitoring) ─────────────────────────
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
