# Read-only product configuration
# Never commit real credentials. Use the deployment platform's secret manager.

APP_ENV=development
READ_ONLY_MODE=true

# Public/read-only data providers
BASE_RPC_URL=
ETH_RPC_URL=
COINBASE_API_KEY=
COINBASE_API_SECRET=
DEXSCREENER_API_BASE=https://api.dexscreener.com

# Notifications (optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database (read-only MVP can start without one)
DATABASE_URL=

# Billing is intentionally disabled until commercial/legal readiness is confirmed.
BILLING_ENABLED=false
EXECUTION_ENABLED=false
