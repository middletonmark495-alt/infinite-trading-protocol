# ── Trading mode ────────────────────────────────────────────────────────────
PAPER_TRADING=true           # false = live execution (Alpaca)
STARTING_CAPITAL=10000       # starting paper capital in USD

# ── Strategy ─────────────────────────────────────────────────────────────────
TIMEFRAME=1h
NUM_CANDLES=200
RSI_PERIOD=14
EMA_FAST=9
EMA_SLOW=21
RISK_PER_TRADE_PCT=2.0       # % of capital risked per trade
STOP_LOSS_PCT=3.0            # % below entry price
TAKE_PROFIT_PCT=6.0          # % above entry price
MAX_OPEN_POSITIONS=5
SCAN_INTERVAL_SECONDS=60     # how often to scan (seconds)

# ── Coinbase crypto pairs ─────────────────────────────────────────────────────
COINBASE_PAIRS=BTC-USD,ETH-USD,SOL-USD,LINK-USD,ARB-USD,MATIC-USD,AAVE-USD,UNI-USD,DOGE-USD,PEPE-USD,SHIB-USD

# ── DexScreener meme coin filters ────────────────────────────────────────────
MEME_MIN_LIQUIDITY_USD=50000      # minimum pool liquidity
MEME_MIN_VOLUME_24H=100000        # minimum 24h trading volume
MEME_MIN_PRICE_CHANGE_1H=5.0      # minimum 1h price change % to consider
MEME_MAX_AGE_HOURS=72             # ignore tokens older than this

# ── Twitter/X (optional — get Bearer Token at developer.twitter.com) ─────────
TWITTER_BEARER_TOKEN=

# ── Telegram (optional — create a bot at @BotFather) ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_IDS=@yourchannel1,@yourchannel2

# ── Discord alerts (optional — create webhook in channel settings) ────────────
DISCORD_WEBHOOK_URL=

# ── Telegram alerts outbound ──────────────────────────────────────────────────
TELEGRAM_ALERT_CHAT_ID=

# ── Alpaca — stocks + futures (optional) ─────────────────────────────────────
# Free paper trading: https://alpaca.markets
# For live trading replace URL with https://api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
STOCK_SYMBOLS=NVDA,TSLA,AAPL,AMZN,META,SPY
FUTURES_SYMBOLS=ES,NQ,CL,GC
